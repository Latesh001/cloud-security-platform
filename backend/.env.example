# Local development environment configuration
# Copy this file to .env and fill in local secrets. Do not put real passwords here.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# --- MongoDB ---
MONGO_URI=mongodb://127.0.0.1:27017/cloud_security_db

# --- Email (Gmail SMTP: use an App Password, not the account password) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- AI Security Assistant ---
# Gemini is the preferred chat model. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional fallback if Gemini is not configured
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# auto | gemini | openai  (auto = Gemini first, then OpenAI, then knowledge base)
LLM_PROVIDER=auto

# --- Session ---
SESSION_TIMEOUT_MINUTES=60

# --- Phase 1 ---
MAX_UPLOAD_SIZE_MB=1000
APPROVAL_SCORE_THRESHOLD=65

# --- Phase 2 ---
MONITORING_INTERVAL_SECONDS=5
THREAT_CONFIDENCE_THRESHOLD=85

# --- Forensic / incident PDF archive (all downloadable PDFs) ---
INCIDENT_REPORTS_FOLDER='D:\mainproject papers\Documents\Incident reports'
REPORTS_FOLDER='D:\mainproject papers\Documents\Incident reports'
